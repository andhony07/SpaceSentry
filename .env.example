# SpaceSentry backend configuration
# Copy to .env and adjust as needed. All values have safe defaults.

# Address the API binds to. Localhost only on purpose: the cleanup API must
# never be reachable from other machines.
SPACESSENTRY_HOST=127.0.0.1
SPACESSENTRY_PORT=8765

# Comma-separated list of browser origins allowed to call the API.
# The Vite dev server runs on 5173 by default.
SPACESSENTRY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
